# Copy to .env for local Docker Compose or deployment configuration.
# Do not commit real secrets.

POSTGRES_USER=investos
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=investos
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# Local runtime state. Keep these pointing at ignored local paths.
STORAGE_DIR=data/storage
BACKUP_DIR=backups
RUNTIME_SETTINGS_PATH=data/runtime_settings.json

# Destructive first-run testing is disabled by default. If temporarily enabled,
# the backend still accepts reset requests only in development from loopback.
DEV_RESET_ENABLED=false

# Prophet is a private local app. This override only permits non-loopback API
# peers; it does not add authentication or make a shared deployment safe.
# API_ALLOW_NON_LOOPBACK=false

# Optional owner-only access through Tailscale Serve. Keep Next.js and FastAPI
# bound to loopback. Add the exact private HTTPS origin to FRONTEND_ORIGINS.
# PROPHET_REMOTE_ACCESS_USER=owner@example.com
# FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://prophet-host.example-tailnet.ts.net

# Optional owner Web Push. Prophet generates the private VAPID identity under
# STORAGE_DIR; never commit or copy that private key into this file.
# WEB_PUSH_ENABLED=true
# WEB_PUSH_VAPID_SUBJECT=mailto:owner@example.com
# WEB_PUSH_DISPATCH_INTERVAL_SECONDS=60
# WEB_PUSH_TIMEOUT_SECONDS=10
# WEB_PUSH_MAX_ATTEMPTS=5

# Bounded manual ingestion and public web fetching.
# INGESTION_MAX_UPLOAD_MB=25
# INGESTION_MAX_NOTE_CHARS=2000000
# PORTFOLIO_IMPORT_MAX_MB=5
# URL_FETCH_TIMEOUT_SECONDS=20
# URL_FETCH_MAX_REDIRECTS=5
# URL_FETCH_MAX_RESPONSE_MB=2
# URL_FETCH_ALLOWED_PORTS=80,443

# Optional free local fallback for YouTube videos without captions. Prophet
# never installs, starts, or enables these tools itself. Install yt-dlp,
# ffmpeg, and the OpenAI Whisper CLI separately before enabling.
# YOUTUBE_LOCAL_TRANSCRIPTION_ENABLED=false
# YOUTUBE_DOWNLOADER_BIN=yt-dlp
# YOUTUBE_TRANSCRIBER_BIN=whisper
# YOUTUBE_TRANSCRIPTION_MODEL=base
# YOUTUBE_TRANSCRIPTION_TIMEOUT_SECONDS=1800
# YOUTUBE_MAX_DURATION_SECONDS=14400
# YOUTUBE_FRAME_OCR_ENABLED=false
# YOUTUBE_OCR_BIN=tesseract
# YOUTUBE_FRAME_INTERVAL_SECONDS=30
# YOUTUBE_FRAME_MAX_COUNT=120
# YOUTUBE_FRAME_EXTRACTION_TIMEOUT_SECONDS=1800
# YOUTUBE_CHANNEL_ENUMERATION_TIMEOUT_SECONDS=45
# YOUTUBE_ADAPTIVE_INVESTIGATION_ENABLED=true
# YOUTUBE_INVESTIGATION_MAX_TRANSCRIPT_CHARS=16000
# YOUTUBE_INVESTIGATION_TIMEOUT_SECONDS=45
# YOUTUBE_CHANNEL_REVIEW_ENABLED=true
# YOUTUBE_CHANNEL_REVIEW_INTERVAL_SECONDS=21600
# YOUTUBE_CHANNEL_REVIEW_SOURCE_LIMIT=10
# YOUTUBE_CHANNEL_REVIEW_VIDEO_LIMIT=12
# YOUTUBE_CHANNEL_AUTO_INGEST_ENABLED=true
# YOUTUBE_CHANNEL_AUTO_INGEST_LIMIT_PER_SOURCE=2
# MEDIA_MAX_DOWNLOAD_MB=512

# Optional runtime providers should be configured through the app settings UI
# or deployment secret manager, not committed here.
# NVIDIA_API_KEY=
# TAVILY_API_KEY=  # optional metered fallback for external source discovery
# GMAIL_APP_PASSWORD=
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
# SHADOW_LLM_TIMEOUT_SECONDS=45
# SHADOW_LESSON_MIN_RUNS=3
# SHADOW_LESSON_MATERIAL_ALPHA=0.01
# SHADOW_LESSON_VALIDATION_CONSISTENCY=0.67
# SHADOW_LESSON_STALE_DAYS=180
# SHADOW_HORIZON_SHORT_DAYS=7
# SHADOW_HORIZON_ADAPTIVE_DAYS=14
# SHADOW_HORIZON_MEDIUM_DAYS=30
# SHADOW_HORIZON_LONG_DAYS=90
# SHADOW_MIN_CHECKPOINT_INTERVAL_SECONDS=21600
# SHADOW_LESSON_CONTEXT_LIMIT=6
# SHADOW_LESSON_RECONCILE_BATCH_SIZE=25
# LLM_ALLOW_LOCAL_PROVIDER=false
# LLM_RECOVERY_PROVIDERS=
# LLM_STRUCTURED_MAX_TOKENS=12000
# CORROBORATION_MIN_INDEPENDENT_SOURCES=2
# CORROBORATION_NEAR_DUPLICATE_MAX_DISTANCE=3
# CORROBORATION_LINEAGE_BACKFILL_BATCH_SIZE=100
# INTEGRITY_INVESTMENT_EDGE_REPAIR_BATCH_SIZE=1000
# REASONING_INDEPENDENT_REVIEW_ENABLED=true
# MARKET_SETUP_ASSESSMENT_INTERVAL_SECONDS=21600
# MARKET_SETUP_ASSESSMENT_BATCH_SIZE=5
# MARKET_SETUP_ASSESSMENT_SCAN_LIMIT=500
# MARKET_SETUP_ASSESSMENT_MIN_CONFIDENCE=0.8
# MARKET_SETUP_ASSESSMENT_GRACE_HOURS=6
# MARKET_SETUP_ASSESSMENT_RETRY_HOURS=24
# MARKET_SETUP_ASSESSMENT_RESEARCH_LIMIT=1
# SOURCE_CLAIM_ASSESSMENT_INTERVAL_SECONDS=86400
# SOURCE_CLAIM_ASSESSMENT_BATCH_SIZE=3
# SOURCE_CLAIM_ASSESSMENT_SCAN_LIMIT=500
# SOURCE_CLAIM_ASSESSMENT_MIN_CONFIDENCE=0.8
# SOURCE_CLAIM_ASSESSMENT_RETRY_HOURS=24
# SOURCE_CLAIM_ASSESSMENT_RETRY_SHARE=0.25
# SOURCE_CLAIM_ASSESSMENT_RESEARCH_LIMIT=1
