    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "react-markdown": "^10.1.0",
    "react-plaid-link": "^4.2.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
